# ─── Backend URL ───────────────────────────────────────────────────
# For Android device on same network: use your machine's local IP
# For Android emulator: use 10.0.2.2 (maps to host machine's localhost)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# ─── Scanner Authentication ───────────────────────────────────────
EXPO_PUBLIC_SCANNER_API_KEY=your_api_key_here
EXPO_PUBLIC_SCANNER_ID=scanner-entrada-01

# ─── Apple VAS ─────────────────────────────────────────────────────
EXPO_PUBLIC_APPLE_VAS_MERCHANT_ID=com.tuempresa.eventapp
